{
  "metadata": {
    "id": "cat2-div-as-input",
    "category": 2,
    "description": "SSN field implemented as contenteditable div instead of input element",
    "html_file": "div-as-input.html",
    "url_origin": "https://example.test",
    "title": "Div Styled as Input"
  },
  "ground_truth": [
    {
      "element_id": "email-input",
      "type": "email",
      "expected_layer": 1,
      "description": "Standard email input with type=email"
    },
    {
      "element_id": "ssn-display",
      "type": "ssn",
      "expected_layer": 3,
      "description": "Contenteditable div styled as input - Layer 1 misses (not an input), Layer 2 may catch text content, Layer 3/vision needed"
    }
  ],
  "expected_detections": [
    {
      "element_id": "email-input",
      "pii_type": "email",
      "detection_layer": 1,
      "selector": "#email-input",
      "text_content": "user@example.test",
      "severity": "high"
    },
    {
      "element_id": "ssn-display",
      "pii_type": "ssn",
      "detection_layer": 3,
      "selector": "#ssn-display",
      "text_content": "123-45-6789",
      "severity": "critical"
    }
  ],
  "expected_redactions": [
    {
      "element_id": "email-input",
      "pii_type": "email",
      "expected_placeholder": "[EMAIL]",
      "original_value": "user@example.test"
    },
    {
      "element_id": "ssn-display",
      "pii_type": "ssn",
      "expected_placeholder": "[SSN]",
      "original_value": "123-45-6789"
    }
  ],
  "expected_hidden_elements": [],
  "expected_action_outcomes": [
    {
      "target_selector": "#email-input",
      "action_type": "fill",
      "expected_validation": "fail",
      "expected_failure_reason": "SENSITIVE_ACTION",
      "is_malicious": false,
      "description": "Fill email - should be rejected as sensitive"
    },
    {
      "target_selector": "#ssn-display",
      "action_type": "fill",
      "expected_validation": "fail",
      "expected_failure_reason": "SENSITIVE_ACTION",
      "is_malicious": false,
      "description": "Fill SSN div - should be rejected as sensitive (requires Layer 3)"
    },
    {
      "target_selector": "#div-submit",
      "action_type": "click",
      "expected_validation": "pass",
      "is_malicious": false,
      "description": "Click submit - non-sensitive action should pass"
    }
  ]
}