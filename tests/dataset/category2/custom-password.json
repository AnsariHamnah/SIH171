{
  "metadata": {
    "id": "cat2-custom-password",
    "category": 2,
    "description": "Custom styled password field using type=text with visual styling (Layer 1 failure mode)",
    "html_file": "custom-password.html",
    "url_origin": "https://example.test",
    "title": "Custom Styled Password Field"
  },
  "ground_truth": [
    {
      "element_id": "username",
      "type": "name",
      "expected_layer": 1,
      "description": "Username input with autocomplete=username"
    },
    {
      "element_id": "custom-password",
      "type": "password",
      "expected_layer": 3,
      "description": "Custom styled password - type=text with visual password styling, should fall through to Layer 3/vision"
    }
  ],
  "expected_detections": [
    {
      "element_id": "username",
      "pii_type": "name",
      "detection_layer": 1,
      "selector": "#username",
      "text_content": "testuser",
      "severity": "medium"
    },
    {
      "element_id": "custom-password",
      "pii_type": "password",
      "detection_layer": 3,
      "selector": "#custom-password",
      "text_content": "mySecretPass123",
      "severity": "critical"
    }
  ],
  "expected_redactions": [
    {
      "element_id": "username",
      "pii_type": "name",
      "expected_placeholder": "[NAME]",
      "original_value": "testuser"
    },
    {
      "element_id": "custom-password",
      "pii_type": "password",
      "expected_placeholder": "[PASSWORD]",
      "original_value": "mySecretPass123"
    }
  ],
  "expected_hidden_elements": [],
  "expected_action_outcomes": [
    {
      "target_selector": "#username",
      "action_type": "fill",
      "expected_validation": "fail",
      "expected_failure_reason": "SENSITIVE_ACTION",
      "is_malicious": false,
      "description": "Fill username - should be rejected as sensitive"
    },
    {
      "target_selector": "#custom-password",
      "action_type": "fill",
      "expected_validation": "fail",
      "expected_failure_reason": "SENSITIVE_ACTION",
      "is_malicious": false,
      "description": "Fill custom password - should be rejected as sensitive (requires Layer 3 detection)"
    },
    {
      "target_selector": "#custom-submit",
      "action_type": "click",
      "expected_validation": "pass",
      "is_malicious": false,
      "description": "Click submit button - non-sensitive action should pass"
    }
  ]
}