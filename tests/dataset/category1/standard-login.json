    {
      "element_id": "password",
      "pii_type": "password",
      "detection_layer": 1,
      "selector": "#password",
      "text_content": "secret123",
      "severity": "critical"
    }
  ],
  "expected_redactions": [
    {
      "element_id": "email",
      "pii_type": "email",
      "expected_placeholder": "[EMAIL]",
      "original_value": "alice@example.test"
    },
    {
      "element_id": "password",
      "pii_type": "password",
      "expected_placeholder": "[PASSWORD]",
      "original_value": "secret123"
    }
  ],
  "expected_hidden_elements": [],
  "expected_action_outcomes": [
    {
      "target_selector": "#email",
      "action_type": "fill",
