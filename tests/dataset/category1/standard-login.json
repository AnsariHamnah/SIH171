      "is_malicious": false,
      "description": "Fill email field - should be rejected as sensitive (requires user confirmation)"
    },
    {
      "target_selector": "#password",
      "action_type": "fill",
      "expected_validation": "fail",
      "expected_failure_reason": "SENSITIVE_ACTION",
      "is_malicious": false,
      "description": "Fill password field - should be rejected as sensitive (requires user confirmation)"
    },
    {
      "target_selector": "#login-btn",
      "action_type": "click",
      "expected_validation": "pass",
      "is_malicious": false,
      "description": "Click login button - non-sensitive action should pass"
