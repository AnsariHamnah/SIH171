    },
    {
      "element_id": "password",
      "type": "password",
      "expected_layer": 1,
      "description": "Password input with type=password and autocomplete=current-password"
    }
  ],
  "expected_detections": [
    {
      "element_id": "email",
      "pii_type": "email",
