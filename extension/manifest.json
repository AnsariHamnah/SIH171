{
  "manifest_version": 3,
  "name": "SIH 26171 - On-device Visual Perception Agent",
  "version": "0.0.0",
  "description": "Privacy-first browser agent with on-device perception and PII redaction",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "offscreen_document": {
    "src": "offscreen.html",
    "reasons": ["WORKERS", "LOCAL_STORAGE"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SIH 26171 Agent"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["wasm/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:;"
  }
}